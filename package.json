{
  "name": "openfpga-deck",
  "displayName": "OpenFPGA Deck",
  "description": "Synthesize, place & route, pack and program open-source FPGAs from VS Code, powered by the YosysHQ OSS CAD Suite.",
  "version": "0.1.0",
  "publisher": "openfpga-deck",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yash-Kamat/openfpga-deck.git"
  },
  "bugs": {
    "url": "https://github.com/Yash-Kamat/openfpga-deck/issues"
  },
  "homepage": "https://github.com/Yash-Kamat/openfpga-deck#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fpga",
    "verilog",
    "systemverilog",
    "yosys",
    "nextpnr",
    "gowin",
    "tang nano 20k",
    "openfpga",
    "bitstream",
    "hdl"
  ],
  "qna": "marketplace",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "OpenFPGA Deck runs FPGA toolchain binaries and writes project files based on fpga.yaml, so it stays inactive until the folder is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "openfpga.initProject",
        "title": "Initialize Project",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.validateProject",
        "title": "Validate Project",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.synthesize",
        "title": "Synthesize",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.placeAndRoute",
        "title": "Place and Route",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.packBitstream",
        "title": "Pack Bitstream",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.build",
        "title": "Build",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.program",
        "title": "Program",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.buildAndProgram",
        "title": "Build and Program",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.detectBoard",
        "title": "Detect Board",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.writeFileToBoard",
        "title": "Write File to Board",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.buildMenu",
        "title": "Build Actions…",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.cancelBuild",
        "title": "Cancel Build",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.verifyToolchain",
        "title": "Verify Toolchain",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.selectToolchain",
        "title": "Select Toolchain",
        "category": "OpenFPGA Deck"
      },
      {
        "command": "openfpga.downloadToolchain",
        "title": "Download Toolchain",
        "category": "OpenFPGA Deck"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "openfpga.buildMenu", "when": "false" },
        { "command": "openfpga.cancelBuild", "when": "false" }
      ]
    },
    "configuration": {
      "title": "OpenFPGA Deck",
      "properties": {
        "openfpga.toolchain.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Absolute path to an OSS CAD Suite installation — the folder that contains `bin/` and `environment` (a parent folder that contains `oss-cad-suite/` also works). Leave empty to auto-detect from PATH and common install locations. For security this cannot be set per-workspace."
        },
        "openfpga.toolchain.installDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Directory that holds your OSS CAD Suite installations. **Download Toolchain** puts each release in its own `oss-cad-suite-<tag>/` folder here and keeps the archives under `downloads/`. Defaults to `~/fpga-toolchain`. Usually set via **Download Toolchain**, not by hand."
        },
        "openfpga.toolchain.keepDownloads": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "Keep the downloaded `.tgz` archives (under `downloads/` in the install directory) after extraction. They are large but let you re-install offline. Turn off to delete each archive once its release is installed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vscode/vsce": "^3.1.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
